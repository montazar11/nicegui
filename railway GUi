    def update_drawing(self):
        """تحديث الرسم"""
        # مسح الرسم
        self.axes.clear()
        self.axes.set_xlim(0, 1000)
        self.axes.set_ylim(0, 600)
        self.axes.axis('off')
        
        # رسم المسارات
        for track_id, track in self.tracks.items():
            color = Colors.TRACK_FREE
            if self.track_states[track_id] == "OCCUPIED":
                color = Colors.TRACK_OCCUPIED
            elif self.track_states[track_id] == "UNKNOWN":
                color = Colors.TRACK_UNKNOWN
            
            self.axes.plot([track["start"][0], track["end"][0]],
                          [track["start"][1], track["end"][1]],
                          color=color, linewidth=track["width"])
            
            # رسم معرف المسار
            mid_x = (track["start"][0] + track["end"][0]) / 2
            mid_y = (track["start"][1] + track["end"][1]) / 2
            self.axes.text(mid_x, mid_y + 15, track_id, ha='center', va='center',
                          fontsize=10, color='black', bbox=dict(facecolor='white', alpha=0.7))
        
        # رسم المفاتيح
        for switch_id, switch in self.switches.items():
            color = Colors.SWITCH_NORMAL
            if self.switch_states[switch_id] == SwitchState.REVERSE:
                color = Colors.SWITCH_REVERSE
            elif self.switch_states[switch_id] == SwitchState.MOVING:
                color = Colors.SWITCH_MOVING
            elif self.switch_states[switch_id] == SwitchState.FAULTY:
                color = Colors.SWITCH_FAULTY
            
            self.axes.plot(switch["position"][0], switch["position"][1], 'o',
                          markersize=switch["radius"], color=color)
            
            # رسم معرف المفتاح
            self.axes.text(switch["position"][0], switch["position"][1] + 20, switch_id,
                          ha='center', va='center', fontsize=10, color='black',
                          bbox=dict(facecolor='white', alpha=0.7))
        
        # رسم الإشارات
        for signal_id, signal in self.signals.items():
            color = Colors.SIGNAL_RED
            if self.signal_states[signal_id] == SignalState.YELLOW:
                color = Colors.SIGNAL_YELLOW
            elif self.signal_states[signal_id] == SignalState.GREEN:
                color = Colors.SIGNAL_GREEN
            elif self.signal_states[signal_id] == SignalState.FAULTY:
                color = Colors.SIGNAL_FAULTY
            
            # رسم الإشارة
            if signal["direction"] == "right":
                self.axes.arrow(signal["position"][0], signal["position"][1],
                               signal["size"], 0, head_width=10, head_length=10,
                               fc=color, ec=color)
            elif signal["direction"] == "left":
                self.axes.arrow(signal["position"][0], signal["position"][1],
                               -signal["size"], 0, head_width=10, head_length=10,

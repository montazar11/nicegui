class StationCanvas(FigureCanvas):
    """لوحة رسم محطة الخطوط الحديدية"""
    
    def __init__(self, parent=None, width=10, height=6, dpi=100):
        """
        تهيئة لوحة الرسم
        
        المعاملات:
            parent (QWidget): العنصر الأب
            width (float): العرض بالبوصة
            height (float): الارتفاع بالبوصة
            dpi (int): عدد النقاط في البوصة
        """
        self.fig = Figure(figsize=(width, height), dpi=dpi)
        self.axes = self.fig.add_subplot(111)
        
        # إعداد الرسم
        self.axes.set_aspect('equal')
        self.axes.set_xlim(0, 1000)
        self.axes.set_ylim(0, 600)
        self.axes.axis('off')
        
        # تهيئة الكائن الأب
        super(StationCanvas, self).__init__(self.fig)
        self.setParent(parent)
        
        # إعداد الكائن
        self.setMinimumSize(800, 480)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.updateGeometry()
        
        # عناصر المحطة
        self.tracks = {}
        self.switches = {}
        self.signals = {}
        self.routes = {}
        self.trains = {}
        self.cameras = {}
        
        # حالة العناصر
        self.track_states = {}
        self.switch_states = {}
        self.signal_states = {}
        self.route_states = {}
        
        # العنصر المحدد
        self.selected_element = None
        self.selected_element_type = None
        
        # إعداد المحطة
        self.setup_station()
        
        # ربط الأحداث
        self.fig.canvas.mpl_connect('button_press_event', self.on_click)
        
        # مؤقت لتحديث الرسم
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_drawing)
        self.timer.start(1000)  # تحديث كل ثانية
    
